# ── Database ─────────────────────────────────────────────
# Isi dengan connection string Postgres (mis. Neon free tier) untuk produksi.
# Saat kosong/ditarik, backend memakai PGlite lokal (Postgres WASM) tanpa setup.
DATABASE_URL=

# ── Site ─────────────────────────────────────────────────
# URL publik yang dipakai metadataBase, canonical, Open Graph, sitemap, robots.
# WAJIB diisi di produksi. Tanpa ini semua URL metadata jatuh ke localhost:3000.
NEXT_PUBLIC_SITE_URL=https://kas.sekolah.sch.id

# ── DOKU Payment Gateway ──────────────────────────────────
# Credential default dibaca dari tabel gateway_settings (bukan env), lihat
# src/db/schema.ts. Env di bawah hanya fallback jika tabel kosong.
# Perhatian: channel e-wallet (DANA/OVO/ShopeePay/GoPay/QRIS) non-aktif di
# merchant ini sehingga tidak muncul di checkout DOKU.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# "sandbox" atau "production". Nilai di tabel gateway_settings menang; env ini
# hanya dipakai saat tabel kosong.
DOKU_ENV=sandbox
# URL publik aplikasi, dipakai sebagai notification_url webhook DOKU.
BASE_URL=https://kas.sekolah.sch.id

# ── Resend (pengiriman email pengingat) ───────────────────
# Pengiriman dijalankan server-side. Tanpa RESEND_API_KEY, permintaan tetap
# membuat notifikasi web, tetapi setiap email dilaporkan "gagal", bukan sukses.
# Ambil key di https://resend.com/api-keys
RESEND_API_KEY=
# Sender berformat "Kas Sekolah <nama@domain-verifikasi>". Domain WAJIB sudah
# diverifikasi di dashboard Resend; kalau belum, kirim hanya ke alamat email
# akun Resend itu sendiri memakai onboarding@resend.dev.
EMAIL_FROM=

# ── Google Apps Script (webhook) ──────────────────────────
# Menerima notifikasi pembayaran DOKU.
# Kosongkan untuk menonaktifkan integrasi.
GAS_WEB_APP_URL=
